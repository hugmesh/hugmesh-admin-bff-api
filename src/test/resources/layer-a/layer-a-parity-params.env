# SHARED Layer-A parity parameters. Read by BOTH writers' gates:
#   * hugmesh-generator  tests/device-registry/test-layer-a-headscale-acl.sh (sources this)
#   * hugmesh-admin-bff-api  HeadscaleAclParityTest (loads it as a java.util.Properties)
# They are the two render inputs that live OUTSIDE the signed export: the mesh whose
# membership tag the SUPERADMIN rule targets, and the node-local unix account every ssh
# rule opens as. KEY=value, no spaces, no quotes — the file must stay loadable by both.
MESH_ID=east-01
TS_SSH_USER=superadmin
