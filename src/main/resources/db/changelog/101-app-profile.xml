<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      app_profile — reusable, SUPERADMIN-owned deploy TEMPLATES for the App-Store. A
      profile is a named bundle of resource/role/cert/exposure DEFAULTS a
      service_deployment (102) can reference, so a superadmin curates a small set of
      templates and stamps them onto many deployments.

      ── GLOBAL, not per-domain ─────────────────────────────────────────────────
      Unlike service_curation (100) and service_deployment (102), app_profile carries
      NO per-row `domain` discriminator: the templates are a shared, superadmin-owned
      library reused ACROSS brands (a "small-postgres" or "public-web" profile is the
      same shape whatever domain deploys it). It is therefore inherently CROSS-DOMAIN
      and only ever read/written by the cross-domain SUPERADMIN role (the controller's
      @PreAuthorize("hasRole('SUPERADMIN')") is the only gate). `name` is the UNIQUE
      natural key.

      ── Portable DDL (mirrors 012-domain-registry.xml) ─────────────────────────
      id is an app-generated varchar(36) UUID string. profile_json is a portable CLOB
      (Liquibase 'clob' -> TEXT on PG, CLOB on H2) holding the JSON defaults document;
      it is read/written as a String (the app does not parse it in PR1 — it is opaque
      template data the later effector resolves). timestamptz -> the portable Liquibase
      'timestamp with time zone' generic type. The PG-only GRANT is gated
      dbms=postgresql onFail=MARK_RAN so the H2 changelog never fails.

      ── Numbering: 101 ─────────────────────────────────────────────────────────
      Sits ABOVE 100 in the free >=100 band (existing ~070; concurrent 080/085/
      090-099). Appended LAST at the include site after 100.
    -->

    <changeSet id="101-app-profile" author="hugmesh">
        <comment>app_profile — reusable superadmin-owned deploy templates (GLOBAL, not
                 per-domain; name UNIQUE; profile_json holds resource/role/cert/exposure
                 defaults).</comment>
        <createTable tableName="app_profile">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- The natural key (NOT NULL + UNIQUE) — the template's reusable name. -->
            <column name="name" type="varchar(128)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_app_profile_name"/>
            </column>
            <!-- Opaque JSON: resource/role/cert/exposure defaults. CLOB so it is portable
                 (TEXT on PG, CLOB on H2); the app stores/returns it as a String in PR1. -->
            <column name="profile_json" type="clob"/>
            <!-- The SUPERADMIN subject (jwt.getSubject()) who created the template. -->
            <column name="created_by_subject" type="varchar(400)"/>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="101-app-profile-grant" author="hugmesh">
        <!-- PostgreSQL-only runtime grant. The H2 test store has no adminbff_app role, so
             GRANT would error there; the dbms precondition skips this changeSet entirely
             off-Postgres (onFail=MARK_RAN records it as run) so the H2 changelog
             continues. On a real Postgres deployment the grant applies. -->
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>GRANT SELECT,INSERT,UPDATE,DELETE on app_profile to the adminbff_app role
                 (a profile is a reusable template — superadmin may remove an unused one).</comment>
        <sql>GRANT SELECT, INSERT, UPDATE, DELETE ON app_profile TO adminbff_app</sql>
        <rollback>REVOKE SELECT, INSERT, UPDATE, DELETE ON app_profile FROM adminbff_app</rollback>
    </changeSet>
</databaseChangeLog>
