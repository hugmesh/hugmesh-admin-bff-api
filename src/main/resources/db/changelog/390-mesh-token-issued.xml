<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      mesh_token_issued — the AUDIT trail of HugMesh tokens v1 issued from the web admin UI
      (net.hugmesh.adminbff.meshtoken, POST /bff/admin/mesh-tokens). One row per token.

      NO SECRET, EVER: there is no column for the token, the headscale pre-auth key, a key
      prefix or the signature. The token is returned once to the issuing admin and never stored.
      preauth_key_id is headscale's numeric key id (what `headscale preauthkeys list` shows), so
      an operator can find and expire the key without it. issuer_fingerprint is the SHA256: form
      of the issuer's PUBLIC key.

      id is the token's own 16-hex id (the payload's "id" field), generated by the issuer — so a
      token in a tray can be matched to its audit row.

      Portable DDL like 172 (the tests run it on Testcontainers Postgres). The indexes and the
      GRANT are gated on dbms=postgresql (onFail/onError=MARK_RAN). The GRANT is SELECT, INSERT to
      adminbff_app (the role admin-bff connects as; never admin_bff): no UPDATE, no DELETE — an
      issued-token record cannot be edited or removed by the application.

      Band 390: 380 (role-mfa-policy-seed) is the last band on main; appended LAST.
    -->

    <changeSet id="390-mesh-token-issued" author="hugmesh">
        <comment>mesh_token_issued — audit record of issued HugMesh tokens. NON-SECRET only.</comment>
        <createTable tableName="mesh_token_issued">
            <column name="id" type="varchar(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mesh" type="varchar(63)">
                <constraints nullable="false"/>
            </column>
            <!-- the access domain (a DNS name, e.g. example.org), not the tenant brand -->
            <column name="domain" type="varchar(253)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="shell" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="login_server" type="varchar(300)">
                <constraints nullable="false"/>
            </column>
            <column name="issuer_fingerprint" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <!-- headscale's numeric pre-auth key id (a string on the wire: uint64 via grpc-gateway) -->
            <column name="preauth_key_id" type="varchar(32)"/>
            <column name="node_name" type="varchar(63)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <!-- the Casdoor subject of the admin who issued it -->
            <column name="issued_by" type="varchar(400)">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="390-mesh-token-issued-role-check" author="hugmesh">
        <comment>CHECK: role is one of the four person tiers; shell only with admin/superadmin
                 (the token format's own rule, held by the table as well).</comment>
        <sql>
            ALTER TABLE mesh_token_issued
                ADD CONSTRAINT ck_mesh_token_issued_role
                CHECK (role IN ('user', 'mod', 'admin', 'superadmin')
                       AND (shell = FALSE OR role IN ('admin', 'superadmin')))
        </sql>
        <rollback>ALTER TABLE mesh_token_issued DROP CONSTRAINT ck_mesh_token_issued_role</rollback>
    </changeSet>

    <changeSet id="390-mesh-token-issued-domain-index" author="hugmesh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>Index the ADMIN read predicate (WHERE domain IN (...) ORDER BY issued_at DESC).</comment>
        <sql>CREATE INDEX idx_mesh_token_issued_domain ON mesh_token_issued (domain, issued_at DESC)</sql>
        <rollback>DROP INDEX idx_mesh_token_issued_domain</rollback>
    </changeSet>

    <changeSet id="390-mesh-token-issued-issued-at-index" author="hugmesh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>Index the SUPERADMIN read (ORDER BY issued_at DESC LIMIT 200).</comment>
        <sql>CREATE INDEX idx_mesh_token_issued_issued_at ON mesh_token_issued (issued_at DESC)</sql>
        <rollback>DROP INDEX idx_mesh_token_issued_issued_at</rollback>
    </changeSet>

    <changeSet id="390-mesh-token-issued-grant" author="hugmesh">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>GRANT SELECT, INSERT on mesh_token_issued to adminbff_app (issue = INSERT, the
                 audit list = SELECT). NEVER UPDATE or DELETE: the row is the audit trail.</comment>
        <sql>GRANT SELECT, INSERT ON mesh_token_issued TO adminbff_app</sql>
        <rollback>REVOKE SELECT, INSERT ON mesh_token_issued FROM adminbff_app</rollback>
    </changeSet>
</databaseChangeLog>
