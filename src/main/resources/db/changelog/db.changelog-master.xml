    <!--
      151 — MFA FACTOR STORAGE (D6+D8 enrollment leg). Within the 150-159 MFA reserve,
      directly after 150's opaque-session columns. The web path cannot use Casdoor's MFA
      endpoints (no standalone factor-verify API; WebAuthn session-bound; TOTP secret masked
      forever after setup), so the BFF OWNS the factor lifecycle: mfa_factor (TOTP secret
      AES-256-GCM encrypted at rest + WebAuthn factor rows), mfa_recovery_code (salted-HMAC
      hash only, one-time consume), webauthn_credential (credentialId + COSE key + monotonic
      sign_count). SHIPS DARK — every /bff/mfa/* endpoint 503s while app.casdoor.mfa.enabled
      =false; no enforcement is wired off these tables in this band. Appended LAST (AFTER the
      150 include) so it runs last regardless of its numeric prefix — bff_session (006) is
      already present. PG-gated index+GRANT via dbms=postgresql onFail=MARK_RAN (the H2 test
      path runs the table creates only).
    -->
    <include file="db/changelog/151-mfa-factors.xml"/>

    <!--
      152 — WEBAUTHN PENDING CHALLENGE (D6+D8 multi-replica leg). Within the 150-159 MFA
      reserve, directly after 151's factor lifecycle storage. Makes the pending WebAuthn
      challenge DURABLE + MULTI-REPLICA-SAFE: the WebAuthnChallengeStore was an in-process
      ConcurrentHashMap, so a cross-node options-then-verify ceremony missed the challenge and
      failed closed (a documented multi-replica GO-LIVE blocker). webauthn_challenge holds one
      PENDING challenge per (owner_subject, ceremony_type REGISTER|ASSERT) with a ~5m expires_at
      and a one-time used flag; consume is an atomic CAS (used=false->true guarded on owner +
      ceremony + unexpired) so a replay / concurrent double-verify loses, and expired rows are
      pruned lazily on put. SHIPS DARK — unreachable while app.casdoor.mfa.enabled=false; the
      durable store only matters when MFA is enabled and admin-bff runs multi-replica. Appended
      LAST (AFTER the 151 include) so it runs last regardless of its numeric prefix — bff_session
      (006) is already present. PG-gated index+GRANT via dbms=postgresql onFail=MARK_RAN (the H2
      test path runs the table create only).
    -->
    <include file="db/changelog/152-webauthn-challenge.xml"/>

