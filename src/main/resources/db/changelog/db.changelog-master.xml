    <!--
      Admin BFF schema, migrated from the old spring.sql.init schema.sql into
      Liquibase changesets. Liquibase runs over a JDBC datasource (Liquibase has
      no R2DBC runner); all runtime data access goes through R2DBC.

      Ordering of the changesets:
        001 — gateway_route_access  (ported from schema.sql, source-of-truth)
        002 — iso_artifacts          (ported from schema.sql)
        003 — allowlist              (NEW durable allowlist: email + discord)
        004 — account                (NEW durable two-stage accounts)
        005 — namespace_grant        (NEW durable per-user namespace grants)
        006 — bff_session            (NEW durable opaque BFF sessions, TTL)
        007 — data constraints       (API<->DB parity: CHECK/FK on provider/roles/
                                      namespace/route-access + bff_session FK)
        050 — backup_history         (cloud Backup & Recovery job history; HIGH
                                      number to avoid colliding with open PRs.)
        060 — announcement           (admin site announcements: per-surface target
                                      flags HOME/LOGIN/akkoma/FORUM + akkoma_ref;
                                      HIGH number to avoid colliding with open PRs.
                                      Appended LAST.)
        070 — test_run               (test-architecture run/report status model:
                                      test_run + per-(suite,role) test_run_result;
                                      HIGH number to avoid colliding with open PRs.
                                      Appended LAST. The admin Test-Reports console
                                      lists/downloads/re-triggers these.)
        008 — access_suspension      (account-states FOUNDATION desired-state +
                                      single-writer reconcile loop source of truth;
                                      kept low-numbered for readability but appended
                                      LAST at the include site. The open
                                      announcements PR ALSO appends here
                                      [060-announcement.xml] — expect a trivial
                                      include-order conflict; keep BOTH. The two
                                      tables are independent so order is irrelevant.)
        009 — domain_lock            (DOMAIN-LOCKED roles desired-state: the
                                      ADD-active force-local source of truth + the
                                      single-writer domain-lock reconcile loop. SIBLING
                                      of 008 — a SEPARATE table because domain-lock is
                                      ADD-semantics [keep the ROLE_*_DOMAINLOCKED
                                      marker] whereas access_suspension is
                                      REMOVE-semantics. Appended LAST after 008.)
    -->

    <include file="db/changelog/001-gateway-route-access.xml"/>
    <include file="db/changelog/002-iso-artifacts.xml"/>
