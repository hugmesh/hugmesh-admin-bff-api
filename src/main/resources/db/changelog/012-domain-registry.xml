<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      domain_registry — the RUNTIME source of truth for which brands/domains exist
      in the cluster, and the SUPERADMIN-managed twin of the BUILD-TIME
      brands/domains.conf that generator PR #79 introduced (multi-tenancy PR9).

      ONE source of truth, two layers (per the multi-tenancy design):
        * build-time  : hugmesh-generator/brands/domains.conf — the rows baked
                        into a USB image at generation (the per-domain CA loop).
        * runtime     : THIS table — the rows a SUPERADMIN adds later from the
                        admin-ui superadmin module; later PRs materialise these into
                        a brand-list ArgoCD ApplicationSet (per-brand namespaces, CA,
                        Casdoor org, gateway/BFF/UI instances). This PR is ONLY the
                        table + SUPERADMIN-gated CRUD; NO ApplicationSet / provisioning
                        effector here.

      ── Column mapping: brands/domains.conf -> domain_registry ──────────────────
      brands/domains.conf is whitespace-separated `DOMAIN [BRAND] [CA_CERT] [CA_KEY]`.
      The runtime table is a COMPATIBLE SUPERSET so build-time + runtime stay one
      source of truth:

        conf column   table column      notes
        ───────────   ────────────      ─────────────────────────────────────────
        DOMAIN    ->  cluster_domain    the brand's base domain (the CLUSTER_DOMAIN).
                                        NOT NULL + UNIQUE (the natural key; the app
                                        validates non-blank + uniqueness).
        BRAND     ->  brand             short slug used in names; conf defaults it to
                                        DOMAIN's first DNS label.
        CA_CERT   ┐                     conf carries FILE PATHS to the imported CA
        CA_KEY    ┘-> ca_ref            material (the bring-your-own-CA drop-in). The
                                        RUNTIME table stores only a CA *REFERENCE*
                                        (e.g. a Vault PKI path / secret name / 'generate')
                                        — NEVER the cert/key bytes, NEVER a private-key
                                        path. The CA private key stays on the key-USB /
                                        Vault; this column is just the pointer the later
                                        ProvisionCa effector resolves. (One ca_ref folds
                                        the conf's CA_CERT+CA_KEY pair: a runtime domain
                                        is generate-by-default, or references imported
                                        material out-of-band.)

      Superset columns the runtime registry adds (the design's row shape
      {BRAND, CLUSTER_DOMAIN, ORG, CA-ref, ns-prefix, Casdoor-org, mesh-tag}):
        org            the brand's organisation/owner label.
        ns_prefix      the k8s namespace prefix the ApplicationSet expands into
                       ${ns_prefix}-pki / -backend / -frontend.
        casdoor_org    the per-brand Casdoor organisation (separate-Casdoor-per-brand;
                       the token issuer is the per-domain discriminator).
        mesh_tag       the headscale/tailnet mesh tag for the brand's nodes.
        enabled        desired-state on/off. A domain is SOFT-DISABLED (enabled=false),
                       NEVER hard-deleted — a declarative registry does not drop a
                       live domain out from under ArgoCD.
        created_at / created_by_subject / updated_at — audit (created_by_subject is
                       stamped from the SUPERADMIN's jwt.getSubject()).

      ── Portable DDL (mirrors 011-device-license-registry.xml EXACTLY) ──────────
      id is an app-generated varchar(36) UUID string (NOT a Postgres uuid column with
      gen_random_uuid()), so the INSERT is portable across Postgres and the H2
      (PostgreSQL-compat, NON_KEYWORDS) test store with no pgcrypto dependency and the
      app can return the new row id. timestamptz -> the portable Liquibase
      'timestamp with time zone' generic type, defaultValueComputed="now()". The
      PG-only GRANT is gated with a dbms=postgresql precondition (onFail=MARK_RAN) so
      the H2 test store — which has no adminbff_app role — never fails the changelog.

      NOTE: domain_registry is the REGISTRY OF BRANDS itself, so it carries NO per-row
      tenant `domain` discriminator (the 010 pattern) — it is inherently CROSS-DOMAIN
      and only ever read/written by the cross-domain SUPERADMIN infra role.

      ── Numbering: 012 ─────────────────────────────────────────────────────────
      Sits ABOVE 011 and is APPENDED LAST at the include site in
      db.changelog-master.xml, immediately after the 011 include.
    -->

    <changeSet id="012-domain-registry" author="hugmesh">
        <comment>domain_registry — the RUNTIME source of truth for cluster brands/domains
                 (SUPERADMIN-managed twin of build-time brands/domains.conf).</comment>
        <createTable tableName="domain_registry">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- brands/domains.conf DOMAIN. The natural key (NOT NULL + UNIQUE). -->
            <column name="cluster_domain" type="varchar(253)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_domain_registry_cluster_domain"/>
            </column>
            <!-- brands/domains.conf BRAND (short slug). -->
            <column name="brand" type="varchar(64)"/>
            <column name="org" type="varchar(255)"/>
            <!-- brands/domains.conf CA_CERT/CA_KEY -> a CA *reference* (NEVER the bytes). -->
            <column name="ca_ref" type="varchar(512)"/>
            <column name="ns_prefix" type="varchar(64)"/>
            <column name="casdoor_org" type="varchar(255)"/>
            <column name="mesh_tag" type="varchar(64)"/>
            <!-- Desired-state on/off; soft-disable instead of hard-delete. -->
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <!-- Stamped from the SUPERADMIN's jwt.getSubject(). -->
            <column name="created_by_subject" type="varchar(400)"/>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="012-domain-registry-grant" author="hugmesh">
        <!-- PostgreSQL-only runtime grant. The H2 test store has no adminbff_app role, so
             GRANT would error there; the dbms precondition skips this changeSet entirely
             off-Postgres (onFail=MARK_RAN records it as run) so the H2 changelog
             continues. On a real Postgres deployment the grant applies. No DELETE — a
             domain is soft-disabled (enabled=false), never hard-deleted. -->
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>GRANT SELECT,INSERT,UPDATE on domain_registry to the adminbff_app role
                 (no DELETE — soft-disable via enabled=false, never hard-delete).</comment>
        <sql>GRANT SELECT, INSERT, UPDATE ON domain_registry TO adminbff_app</sql>
        <rollback>REVOKE SELECT, INSERT, UPDATE ON domain_registry FROM adminbff_app</rollback>
    </changeSet>
    <!--
      ══════════════════════════════════════════════════════════════════════════════════
      DECISION 29 (operator, 2026-09-17, hugmesh/hugmesh-generator#347 comment 5722264043)
      ══════════════════════════════════════════════════════════════════════════════════
      The four element fields the generator's per-domain Casdoor ApplicationSet
      (hugmesh-generator specs/cluster/apps/05b-casdoor-domains.yaml) dereferences under
      goTemplateOptions ["missingkey=error"] but domain_registry could not supply. The
      answers, verbatim:

        29a  the slug rule is `ns_prefix`. It ALSO names the Vault path
             secret/<slug>/casdoor, so namespace and secret path now agree, and a wrong
             slug MIS-ADDRESSES A SECRET rather than merely mis-naming an Application.
             => ns_prefix becomes the domain's SLUG: UNIQUE here, DNS-1123-label
                validated + IMMUTABLE after create in DomainRegistryService.
        29b  ADD the `idp` column (own|superdomain) rather than deriving it.
        29c  the domain_registry WRITER allocates selinux_level / selinux_level_pg AT
             INSERT, UNDER A UNIQUENESS CONSTRAINT, because docs/SECURITY.md §3 requires
             cluster-unique MCS categories (a duplicate category fails OPEN — two
             workloads share a category and nothing in the cluster detects it).

      WHY THESE ARE NEW changeSets IN THIS FILE RATHER THAN EDITS TO 012-domain-registry
      OR A NEW BAND FILE: the answer names 012-domain-registry.xml as the home for the
      idp column. EDITING the shipped 012-domain-registry changeSet would change its
      Liquibase checksum and fail validation on every database it has already run on, so
      the columns are APPENDED as their own changeSets — same file, new ids, no checksum
      of an already-applied changeSet touched. Liquibase runs an unrun changeSet wherever
      it sits in the file; on a fresh database these apply immediately after the
      createTable, on an existing one they apply as ordinary new migrations (the band-190
      status columns having already been added is irrelevant — these are additive).

      MIGRATION COST, STATED: 012-domain-registry-ns-prefix-unique adds a UNIQUE
      constraint to an EXISTING column. On a database that already holds two rows with
      the same non-null ns_prefix the migration FAILS (loudly, at startup) — that is the
      correct outcome under 29a (two domains sharing a slug share a Vault secret path),
      but it is a cost, and it is why this is called out here rather than discovered at a
      deployment. NULL ns_prefix values do NOT collide (SQL UNIQUE treats NULLs as
      distinct in both PostgreSQL and the H2 PG-compat test store), so pre-decision rows
      that never set one migrate cleanly and are refused at the SERVICE layer instead.
    -->

    <changeSet id="012-domain-registry-idp" author="hugmesh">
        <comment>domain_registry.idp (decision 29b) — which Casdoor serves this domain's
                 sign-in: 'superdomain' (ride the mesh's central Casdoor — the default, and
                 the Studio Domain dataclass default) or 'own' (the domain runs its own
                 per-domain Casdoor instance). This is the generator ApplicationSet's SELECTOR
                 gate: only idp='own' elements generate a casdoor-&lt;slug&gt; Application.
                 NOT NULL DEFAULT 'superdomain' so every existing row back-fills to the
                 ride-the-superdomain floor and a fresh row provisions NOTHING until a
                 SUPERADMIN opts it in.</comment>
        <addColumn tableName="domain_registry">
            <column name="idp" type="varchar(16)" defaultValue="superdomain">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="domain_registry" columnName="idp"/>
        </rollback>
    </changeSet>

    <changeSet id="012-domain-registry-idp-check" author="hugmesh">
        <comment>API&lt;-&gt;DB parity: idp pinned to the own/superdomain vocabulary (the
                 310-backing-service-mode CHECK idiom). The service refuses anything else with
                 a 400; this is the backstop against a hand-written UPDATE.</comment>
        <sql>ALTER TABLE domain_registry ADD CONSTRAINT ck_domain_registry_idp
             CHECK (idp IN ('own', 'superdomain'))</sql>
        <rollback>ALTER TABLE domain_registry DROP CONSTRAINT ck_domain_registry_idp</rollback>
    </changeSet>

    <changeSet id="012-domain-registry-selinux-levels" author="hugmesh">
        <comment>domain_registry.selinux_level / selinux_level_pg (decision 29c) — the per-domain
                 MCS categories the ApplicationSet patches onto the casdoor-domain Deployment and
                 its Postgres Deployment. NULLABLE: existing rows predate the allocator and are
                 refused at provisioning time rather than back-filled with a guessed category
                 (a WRONG category is worse than a missing one — it silently co-locates two
                 workloads). Every row inserted from here on is allocated a pair.</comment>
        <addColumn tableName="domain_registry">
            <column name="selinux_level" type="varchar(32)"/>
        </addColumn>
        <addColumn tableName="domain_registry">
            <column name="selinux_level_pg" type="varchar(32)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="domain_registry" columnName="selinux_level"/>
            <dropColumn tableName="domain_registry" columnName="selinux_level_pg"/>
        </rollback>
    </changeSet>

    <changeSet id="012-domain-registry-selinux-level-unique" author="hugmesh">
        <comment>decision 29c's UNIQUENESS CONSTRAINT, half one: no two domains share the
                 casdoor-pod category. This is the arbiter the allocator races against — the
                 allocator reads the taken set and inserts, and THIS constraint (not the read)
                 is what makes a concurrent insert lose instead of silently colliding.</comment>
        <addUniqueConstraint tableName="domain_registry" columnNames="selinux_level"
                             constraintName="uq_domain_registry_selinux_level"/>
        <rollback>
            <dropUniqueConstraint tableName="domain_registry"
                                  constraintName="uq_domain_registry_selinux_level"/>
        </rollback>
    </changeSet>

    <changeSet id="012-domain-registry-selinux-level-pg-unique" author="hugmesh">
        <comment>decision 29c's UNIQUENESS CONSTRAINT, half two: no two domains share the
                 Postgres-pod category.</comment>
        <addUniqueConstraint tableName="domain_registry" columnNames="selinux_level_pg"
                             constraintName="uq_domain_registry_selinux_level_pg"/>
        <rollback>
            <dropUniqueConstraint tableName="domain_registry"
                                  constraintName="uq_domain_registry_selinux_level_pg"/>
        </rollback>
    </changeSet>

    <changeSet id="012-domain-registry-selinux-level-distinct" author="hugmesh">
        <comment>The CROSS-COLUMN half the two UNIQUE constraints cannot express: a per-column
                 UNIQUE does NOT stop domain A's selinux_level equalling domain B's
                 selinux_level_pg, and docs/SECURITY.md §3 forbids ANY two workloads sharing a
                 category. The allocator makes that structurally impossible (it hands out an
                 EVEN offset to selinux_level and the ODD one above it to selinux_level_pg, so
                 the two columns draw from disjoint halves of the reserved range); this CHECK is
                 the DB backstop for the same-row case a hand-written UPDATE could still create.
                 NULL-tolerant by SQL's three-valued logic, so pre-decision rows migrate.</comment>
        <sql>ALTER TABLE domain_registry ADD CONSTRAINT ck_domain_registry_selinux_level_distinct
             CHECK (selinux_level IS NULL OR selinux_level_pg IS NULL
                    OR selinux_level &lt;&gt; selinux_level_pg)</sql>
        <rollback>ALTER TABLE domain_registry
                  DROP CONSTRAINT ck_domain_registry_selinux_level_distinct</rollback>
    </changeSet>

    <changeSet id="012-domain-registry-ns-prefix-unique" author="hugmesh">
        <comment>decision 29a: ns_prefix IS the slug. It names the Application
                 (casdoor-&lt;slug&gt;), the tenant namespace (&lt;slug&gt;-pki) AND the Vault
                 path secret/&lt;slug&gt;/casdoor, so two domains sharing one would share a
                 SECRET. UNIQUE here; DNS-1123-label validated and immutable-after-create in
                 the service. NULLs stay distinct (pre-decision rows migrate; the service
                 refuses to create another one).</comment>
        <addUniqueConstraint tableName="domain_registry" columnNames="ns_prefix"
                             constraintName="uq_domain_registry_ns_prefix"/>
        <rollback>
            <dropUniqueConstraint tableName="domain_registry"
                                  constraintName="uq_domain_registry_ns_prefix"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
