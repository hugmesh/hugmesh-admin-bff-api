<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <!--
    ADMIN-ONLY MATRIX ACCOUNT DEACTIVATE — the propose/confirm token store
    (hugmesh-mod-bff-api#23; operator decisions 83a = C and 83b = B, 2026-09-23).

    tuwunel's `!admin users deactivate` is ONE-WAY (there is no activate verb), so the
    ADMIN endpoint that posts it takes two calls: POST .../propose returns a short-lived,
    single-use token bound to (mxid, acting admin subject); POST .../confirm must carry it
    back inside the window. This table is where that token lives.

    WHY A TABLE: admin-bff runs behind an HPA with minReplicas 2, so the two calls can be
    served by different replicas; an in-memory token map would refuse about half of all
    legitimate confirms. Single use is a CAS (state proposed -> confirmed) that exactly one
    replica can win.

    token_hash is the SHA-256 (hex) of the token; the raw token is returned once by the
    propose call and never stored. Rows are never deleted: they are the audit trail of both
    calls. The GRANT targets adminbff_app (the role admin-bff connects as), never admin_bff.
  -->
  <changeSet id="370-1-matrix-admin-deactivate-proposal" author="hugmesh">
    <createTable tableName="matrix_admin_deactivate_proposal">
      <column name="id" type="varchar(36)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="token_hash" type="varchar(64)">
        <constraints nullable="false" unique="true"
                     uniqueConstraintName="uq_matrix_admin_deactivate_token_hash"/>
      </column>
      <!-- The normalised target MXID (@localpart:server). -->
      <column name="mxid" type="varchar(320)">
        <constraints nullable="false"/>
      </column>
      <!-- The acting admin's subject; only this subject may confirm. -->
      <column name="proposed_by" type="varchar(400)">
        <constraints nullable="false"/>
      </column>
      <column name="proposed_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="expires_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="state" type="varchar(16)" defaultValue="proposed">
        <constraints nullable="false"/>
      </column>
      <column name="confirmed_at" type="timestamp with time zone"/>
      <!-- stubbed | posted:<event_id> | degraded:<reason> (never "ok": the effect is async). -->
      <column name="outcome" type="varchar(512)"/>
    </createTable>
  </changeSet>

  <changeSet id="370-2-matrix-admin-deactivate-proposal-state-check" author="hugmesh">
    <comment>CHECK: a proposal is proposed or confirmed. Expiry is a time comparison, not a
             state, so an unconfirmed expired row stays 'proposed' and simply can never win
             the confirm CAS.</comment>
    <sql>
      ALTER TABLE matrix_admin_deactivate_proposal
          ADD CONSTRAINT ck_matrix_admin_deactivate_state
          CHECK (state IN ('proposed', 'confirmed'))
    </sql>
    <rollback>ALTER TABLE matrix_admin_deactivate_proposal DROP CONSTRAINT ck_matrix_admin_deactivate_state</rollback>
  </changeSet>

  <changeSet id="370-3-matrix-admin-deactivate-proposal-window-check" author="hugmesh">
    <comment>CHECK: the confirmation window is non-empty, and a confirmed row carries its
             confirmation time.</comment>
    <sql>
      ALTER TABLE matrix_admin_deactivate_proposal
          ADD CONSTRAINT ck_matrix_admin_deactivate_window
          CHECK (expires_at &gt; proposed_at
                 AND (state = 'proposed' OR confirmed_at IS NOT NULL))
    </sql>
    <rollback>ALTER TABLE matrix_admin_deactivate_proposal DROP CONSTRAINT ck_matrix_admin_deactivate_window</rollback>
  </changeSet>

  <changeSet id="370-4-matrix-admin-deactivate-proposal-grant" author="hugmesh">
    <preConditions onFail="MARK_RAN" onError="MARK_RAN">
      <dbms type="postgresql"/>
    </preConditions>
    <comment>GRANT SELECT, INSERT, UPDATE to adminbff_app. No DELETE: the rows are the audit
             trail of every propose and confirm.</comment>
    <sql>GRANT SELECT, INSERT, UPDATE ON matrix_admin_deactivate_proposal TO adminbff_app</sql>
    <rollback>REVOKE SELECT, INSERT, UPDATE ON matrix_admin_deactivate_proposal FROM adminbff_app</rollback>
  </changeSet>
</databaseChangeLog>
